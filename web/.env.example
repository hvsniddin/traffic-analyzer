# Base URL of the inference API (POST /api/jobs, GET /api/jobs/{id}).
# Leave empty to run the demo against a clearly labelled mock.
NEXT_PUBLIC_API_URL=
# Published demo limits; keep in sync with the API's own checks.
NEXT_PUBLIC_MAX_UPLOAD_MB=200
NEXT_PUBLIC_MAX_DURATION_SEC=120
NEXT_PUBLIC_REPO_URL=https://github.com/hvsniddin/traffic-analyzer
